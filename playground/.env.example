SEDNA_DATABASE_URL=postgres://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require
SEDNA_URL=http://localhost:4321
# Generate each independently with: openssl rand -hex 32
SEDNA_SECRET=
# Required only to create the first admin. Remove after setup.
SEDNA_SETUP_TOKEN=
# Required for image uploads. Keep this token on the server.
UPLOADTHING_TOKEN=

# Optional: per runtime pool, three pools per server process.
SEDNA_DATABASE_POOL_MAX=5
# Connection acquisition/opening timeout; does not cancel running queries.
SEDNA_DATABASE_CONNECTION_TIMEOUT_MS=10000
