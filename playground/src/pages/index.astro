---
export const prerender = false;

import { getLiveCollection } from 'astro:content';
import PackageCard from '../components/PackageCard.astro';
import { examplePackages } from '../examples/package';
import Site from '../layouts/Site.astro';

const requestedPage = Number(Astro.url.searchParams.get('page') ?? 1);
const page =
  Number.isSafeInteger(requestedPage) && requestedPage > 0 && requestedPage <= 1_000_000
    ? requestedPage
    : 1;
const pageSize = 10;
const [posts, testimonials, packages] = await Promise.all([
  getLiveCollection('posts', { limit: pageSize + 1, offset: (page - 1) * pageSize }),
  getLiveCollection('testimonials'),
  getLiveCollection('packages'),
]);
const hasNext = (posts.entries?.length ?? 0) > pageSize;
---

<Site>
  <h1>Playground</h1>
  <section class="packages" aria-labelledby="packages-heading">
    <h2 id="packages-heading">Travel packages</h2>
    <p>Highlights and daily activities, kept in the order set by the editor.</p>
    {packages.error && <p role="status">Could not load travel packages.</p>}
    {packages.entries?.length ? (
      <div class="package-list">
        {packages.entries.map(({ data }) => (
          <PackageCard data={data} />
        ))}
      </div>
    ) : (
      <div class="package-preview">
        <p class="preview-note">
          Example previews. Publish a package in <a href="/admin">Admin</a> to replace these
          examples with your content.
        </p>
        <div class="package-list">
          {examplePackages.map((data) => (
            <PackageCard data={data} />
          ))}
        </div>
      </div>
    )}
  </section>

  <h2>Posts</h2>
  {posts.error ? (
    <p role="status">Could not load posts.</p>
  ) : (
    <ul class="post-grid">
      {posts.entries?.slice(0, pageSize).map(({ id, data }) => (
        <li class="post-card">
          <a class="post-link" href={`/posts/${encodeURIComponent(id)}`}>
            {(data.date || data.reading_time != null) && (
              <span class="post-meta">
                {data.date && <time datetime={data.date}>{data.date}</time>}
                {data.reading_time != null && <span>{data.reading_time} minute read</span>}
              </span>
            )}
            <h3>{data.title}</h3>
            <span class="post-cta">
              Read post <span aria-hidden="true">↗</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  )}
  {!posts.error && !posts.entries?.length && <p>No posts.</p>}
  {(page > 1 || hasNext) && (
    <nav class="pagination" aria-label="Pagination">
      {page > 1 && (
        <a href={`/?page=${page - 1}`} rel="prev">
          Previous
        </a>
      )}{' '}
      Page {page}{' '}
      {!posts.error && hasNext && (
        <a href={`/?page=${page + 1}`} rel="next">
          Next
        </a>
      )}
    </nav>
  )}

  <section class="testimonials" aria-labelledby="testimonials-heading">
    <h2 id="testimonials-heading">Testimonials</h2>
    {testimonials.error ? (
      <p role="status">Could not load testimonials.</p>
    ) : (
      <div class="testimonial-grid">
        {testimonials.entries?.map(({ data }) => (
          <figure class="testimonial-card">
            <span class="quote-mark" aria-hidden="true">
              “
            </span>
            <blockquote>{data.quote}</blockquote>
            <figcaption>
              <span class="author-initial" aria-hidden="true">
                {data.name?.trim().charAt(0).toUpperCase()}
              </span>
              <div>
                <span class="author-name">{data.name}</span>
                {(data.role || data.company) && (
                  <span class="author-details">
                    {[data.role, data.company].filter(Boolean).join(' · ')}
                  </span>
                )}
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    )}
    {!testimonials.error && !testimonials.entries?.length && <p>No testimonials.</p>}
  </section>
</Site>

<style>
.packages {
  margin-bottom: 3rem;
}

.package-list {
  display: grid;
  gap: 1.5rem;
}

.preview-note {
  color: #52525b;
  font-size: 0.875rem;
}

.testimonials {
  margin-top: 3rem;
}

.post-grid,
.testimonial-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
  gap: 1rem;
}

.post-grid {
  padding: 0;
  list-style: none;
}

.post-card,
.testimonial-card {
  display: flex;
  flex-direction: column;
  min-width: 0;
  margin: 0;
  border: 1px solid #e4e4e7;
  border-radius: 1rem;
  background: #fafafa;
  overflow-wrap: anywhere;
}

.testimonial-card,
.post-link {
  padding: 1.5rem;
}

.post-link {
  display: flex;
  flex: 1;
  flex-direction: column;
  border-radius: inherit;
  text-decoration: none;
}

.post-link:hover {
  background: #f4f4f5;
}

.post-link:focus-visible {
  outline: 2px solid #3f3f46;
  outline-offset: 3px;
}

.post-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 0.25rem 1rem;
  color: #71717a;
  font-size: 0.8125rem;
}

.post-link h3 {
  margin: 0.75rem 0 1.5rem;
  color: #27272a;
  font-size: 1.25rem;
  line-height: 1.4;
}

.post-cta {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  margin-top: auto;
  color: #52525b;
  font-size: 0.875rem;
  font-weight: 600;
}

.pagination {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.75rem;
  margin-top: 1.5rem;
  color: #52525b;
  font-size: 0.875rem;
}

.pagination a {
  padding: 0.375rem 0.75rem;
  border: 1px solid #e4e4e7;
  border-radius: 0.5rem;
  text-decoration: none;
}

.pagination a:hover {
  background: #f4f4f5;
}

.quote-mark {
  height: 2.5rem;
  color: #71717a;
  font-family: Georgia, serif;
  font-size: 4rem;
  line-height: 1;
}

blockquote {
  flex: 1;
  margin: 0.75rem 0 1.5rem;
  color: #27272a;
  font-size: 1.0625rem;
  line-height: 1.7;
  white-space: pre-line;
}

figcaption {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.author-initial {
  display: grid;
  flex-shrink: 0;
  place-items: center;
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 50%;
  background: #e4e4e7;
  color: #3f3f46;
  font-size: 0.875rem;
  font-weight: 600;
}

.author-name,
.author-details {
  display: block;
  font-size: 0.875rem;
}

.author-name {
  font-weight: 600;
}

.author-details {
  margin-top: 0.125rem;
  color: #71717a;
}
</style>
