---
export const prerender = false;

import { getLiveCollection } from 'astro:content';
import Site from '../layouts/Site.astro';

const requestedPage = Number(Astro.url.searchParams.get('page') ?? 1);
const page =
  Number.isSafeInteger(requestedPage) && requestedPage > 0 && requestedPage <= 1_000_000
    ? requestedPage
    : 1;
const pageSize = 10;
const [posts, testimonials] = await Promise.all([
  getLiveCollection('posts', { limit: pageSize + 1, offset: (page - 1) * pageSize }),
  getLiveCollection('testimonials'),
]);
const hasNext = (posts.entries?.length ?? 0) > pageSize;
---

<Site>
  <h1>Playground</h1>
  <h2>Posts</h2>
  {posts.error ? (
    <p role="status">Could not load posts.</p>
  ) : (
    <ul>
      {posts.entries?.slice(0, pageSize).map(({ id, data }) => (
        <li>
          <a href={`/posts/${encodeURIComponent(id)}`}>{data.title}</a>
        </li>
      ))}
    </ul>
  )}
  {!posts.error && !posts.entries?.length && <p>No posts.</p>}
  {(page > 1 || hasNext) && (
    <nav aria-label="Pagination">
      {page > 1 && (
        <a href={`/?page=${page - 1}`} rel="prev">
          Previous
        </a>
      )}{' '}
      Page {page}{' '}
      {!posts.error && hasNext && (
        <a href={`/?page=${page + 1}`} rel="next">
          Next
        </a>
      )}
    </nav>
  )}

  <h2>Testimonials</h2>
  {testimonials.error ? (
    <p role="status">Could not load testimonials.</p>
  ) : (
    testimonials.entries?.map(({ data }) => (
      <figure>
        <blockquote>{data.quote}</blockquote>
        <figcaption>{[data.name, data.role, data.company].filter(Boolean).join(' · ')}</figcaption>
      </figure>
    ))
  )}
  {!testimonials.error && !testimonials.entries?.length && <p>No testimonials.</p>}
</Site>
