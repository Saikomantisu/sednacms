---
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
}
const { title = 'Playground', description = 'CMS playground.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content={description}>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <nav aria-label="Main navigation"><a href="/">Playground</a> · <a href="/admin">Admin</a></nav>
    <main id="main"><slot /></main>
  </body>
</html>
