---
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width">
    <title>{title} | Studio</title>
  </head>
  <body>
    <nav aria-label="Main">
      <a href="/">Studio</a>
      · <a href="/about">About</a> · <a href="/blog">Blog</a>
    </nav>
    <main><slot /></main>
  </body>
</html>
<style is:global>
body {
  max-width: 44rem;
  margin: 3rem auto;
  padding: 0 1.5rem;
  font:
    1.125rem / 1.6 system-ui,
    sans-serif;
  color: #172033;
}
nav {
  margin-bottom: 3rem;
}
a {
  color: #244bd6;
}
</style>
