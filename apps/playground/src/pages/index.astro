---
export const prerender = false;

import { getLiveCollection } from 'astro:content';
import PostCard from '../components/PostCard.astro';
import Site from '../layouts/Site.astro';

const [posts, testimonials] = await Promise.all([
  getLiveCollection('posts'),
  getLiveCollection('testimonials'),
]);

for (const result of [posts, testimonials]) {
  if (result.error) throw result.error;
}

// The newest post is shown larger than the rest.
const [featured, ...others] = posts.entries;

const services = [
  { title: 'Websites', text: 'Fast, accessible sites for small businesses, built with Astro.' },
  { title: 'Content setups', text: 'A simple CMS so your team can edit without calling me.' },
  { title: 'Rescue jobs', text: 'Slow or broken site? I find the cause and fix it.' },
];
---

<Site>
  <section class="max-w-3xl pb-8 pt-10">
    <p
      class="inline-flex items-center gap-2 rounded-full border border-slate-200 px-3 py-1 text-sm font-medium text-slate-700"
    >
      <span aria-hidden="true" class="size-2 rounded-full bg-blue-600"></span>
      Available for new projects
    </p>
    <h1 class="mt-6 text-4xl font-bold text-balance text-slate-900 sm:text-6xl">
      I build fast, friendly websites for small teams.
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-pretty sm:text-xl">
      I'm Maya, a freelance web developer. I work with startups and small businesses, and I write
      here about what I learn along the way.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="#posts"
        class="rounded-full bg-blue-600 px-6 py-3 font-semibold text-white hover:bg-blue-700"
      >
        Read the blog
      </a>
      <a
        href="mailto:maya@example.com"
        class="rounded-full border border-slate-300 px-6 py-3 font-semibold text-slate-900 hover:border-slate-400"
      >
        Get in touch
      </a>
    </div>
  </section>

  <section id="posts" class="mt-20 scroll-mt-8">
    <h2 class="text-3xl font-bold text-balance text-slate-900">Latest posts</h2>
    {featured ? (
      <div class="mt-8 space-y-6">
        <PostCard {...featured} featured />
        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {others.map((post) => (
            <li>
              <PostCard {...post} />
            </li>
          ))}
        </ul>
      </div>
    ) : (
      <p class="mt-4 text-pretty">
        No posts yet.{' '}
        <a href="/admin" class="text-blue-600 underline">
          Write the first one in Admin
        </a>
        .
      </p>
    )}
  </section>

  <section class="mt-24">
    <h2 class="text-3xl font-bold text-balance text-slate-900">What I do</h2>
    <ul class="mt-8 grid gap-8 md:grid-cols-3">
      {services.map((service, index) => (
        <li class="border-t border-slate-200 pt-5">
          <p class="font-mono text-sm text-blue-600">0{index + 1}</p>
          <h3 class="mt-2 text-xl font-semibold text-slate-900">{service.title}</h3>
          <p class="mt-2 text-pretty">{service.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section id="testimonials" class="mt-24 scroll-mt-8 rounded-3xl bg-slate-50 p-6 sm:p-10">
    <h2 class="text-3xl font-bold text-balance text-slate-900">What clients say</h2>
    {testimonials.entries.length === 0 && (
      <p class="mt-4 text-pretty">
        No testimonials yet.{' '}
        <a href="/admin" class="text-blue-600 underline">
          Add one in Admin
        </a>
        .
      </p>
    )}
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {testimonials.entries.map(({ data }) => (
        <figure class="flex flex-col justify-between rounded-2xl bg-white p-6 shadow-sm">
          <blockquote class="text-pretty text-slate-800">“{data.quote}”</blockquote>
          <figcaption class="mt-6 flex items-center gap-3">
            <span
              aria-hidden="true"
              class="grid size-10 shrink-0 place-items-center rounded-full bg-blue-600 font-semibold text-white"
            >
              {data.name.charAt(0)}
            </span>
            <span>
              <strong class="block text-slate-900">{data.name}</strong>
              <span class="text-sm">{[data.role, data.company].filter(Boolean).join(', ')}</span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="mt-24 rounded-3xl bg-slate-900 px-6 py-14 text-center sm:px-10">
    <h2 class="text-3xl font-bold text-balance text-white">Have a project in mind?</h2>
    <p class="mx-auto mt-3 max-w-md text-pretty text-slate-300">
      Tell me what you are building. I reply within two working days.
    </p>
    <a
      href="mailto:maya@example.com"
      class="mt-8 inline-block rounded-full bg-blue-600 px-6 py-3 font-semibold text-white hover:bg-blue-500"
    >
      maya@example.com
    </a>
  </section>
</Site>
