{
  "name": "sednacms",
  "version": "0.1.0",
  "description": "An open-source CMS for Astro. Clients edit content in an admin panel and changes go live within seconds.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "astro-integration",
    "withastro",
    "cms"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./demo": {
      "types": "./dist/demo/index.d.ts",
      "default": "./dist/demo/index.js"
    },
    "./fields": {
      "types": "./dist/fields.d.ts",
      "default": "./dist/fields.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "npm run build && cp ../../README.md ../../LICENSE .",
    "build": "tsc && node scripts/copy-admin.mjs",
    "dev": "npm run build && tsc --watch",
    "test": "node --test tests/*.test.mjs",
    "test:types": "tsc -p tests/tsconfig.json",
    "test:auth": "npm run build && node --test tests/auth.test.mjs",
    "test:fields": "npm run build && tsc -p tests/tsconfig.json && node --test tests/fields.test.mjs",
    "test:admin": "npm run build && node --test tests/admin.test.mjs",
    "test:cache": "npm run build && node --test tests/cache.test.mjs tests/cdn.test.mjs tests/cdn-runtime.test.mjs",
    "test:platform": "npm run build && node --test tests/platform.test.mjs",
    "test:uploads": "npm run build && node --test tests/uploads.test.mjs",
    "test:api": "npm run build && npm run build -w sednacms-playground && node --test tests/content.test.mjs",
    "test:loader": "npm run build && node --test tests/loader.test.mjs tests/log.test.mjs",
    "test:demo": "npm run build && node --test tests/demo.test.mjs"
  },
  "peerDependencies": {
    "astro": ">=6.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@jsquash/avif": "2.1.1",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/resize": "2.1.1",
    "@jsquash/webp": "1.5.0",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extensions": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "better-auth": "1.7.14",
    "dompurify": "^3.4.17",
    "jsdom": "^31.0.0",
    "lucide-astro": "^0.556.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "uploadthing": "^7.7.4"
  }
}
