{
  "name": "sednacms",
  "version": "0.0.0",
  "description": "An open-source CMS for Astro. Clients edit content in an admin panel and changes go live within seconds.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "astro-integration",
    "withastro",
    "cms"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test:auth": "npm run build && node --test tests/auth.test.mjs",
    "test:api": "npm run build && npm run build --prefix playground && node --test tests/content.test.mjs"
  },
  "peerDependencies": {
    "astro": ">=6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "astro": "^7.4.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "better-auth": "1.7.14",
    "pg": "^8.23.1",
    "postgres": "^3.4.9"
  }
}
