{
  "name": "sednacms",
  "version": "0.0.0",
  "description": "An open-source CMS for Astro. Clients edit content in an admin panel and changes go live within seconds.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "astro-integration",
    "withastro",
    "cms"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "husky",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "build": "tsc && node scripts/copy-admin.mjs",
    "dev": "npm run build && tsc --watch",
    "test:auth": "npm run build && node --test tests/auth.test.mjs",
    "test:admin": "npm run build && node --test tests/admin.test.mjs",
    "test:api": "npm run build && npm run build --prefix playground && node --test tests/content.test.mjs"
  },
  "peerDependencies": {
    "astro": ">=6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.2",
    "husky": "^9.1.7",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@tiptap/core": "^3.32.2",
    "@tiptap/extensions": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "better-auth": "1.7.14",
    "dompurify": "^3.4.17",
    "lucide-astro": "^0.556.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8"
  }
}
