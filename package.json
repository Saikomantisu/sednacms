{
  "name": "sednacms-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "husky",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "build": "npm run build -w sednacms",
    "build:playground": "npm run build -w sednacms && npm run build -w sednacms-playground",
    "test": "npm run build:playground && npm run test:types -w sednacms && npm test -w sednacms",
    "playground:dev": "npm run dev -w sednacms-playground",
    "playground:seed": "npm run seed -w sednacms-playground",
    "docs:dev": "npm run dev -w sednacms-docs",
    "docs:build": "npm run build -w sednacms-docs",
    "docs:preview": "npm run preview -w sednacms-docs",
    "docs:check": "npm run check -w sednacms-docs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "husky": "^9.1.7"
  },
  "overrides": {
    "effect": "3.22.4"
  }
}
